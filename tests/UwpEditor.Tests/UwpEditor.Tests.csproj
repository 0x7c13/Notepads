<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseUwp>true</UseUwp>
    <EnableMsixTooling>true</EnableMsixTooling>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <DefaultLanguage>en-US</DefaultLanguage>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <CsWinRTGenerateProjection>false</CsWinRTGenerateProjection>
    <Configurations>Debug;Release;Production</Configurations>
    <OutputType>WinExe</OutputType>
    <PublishAot>true</PublishAot>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <PublishAppxPackage>true</PublishAppxPackage>
    <IncludePublishItemsOutputGroup Condition="'$(Configuration)' != 'Debug'">true</IncludePublishItemsOutputGroup>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <SelfContained>true</SelfContained>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxAutoIncrementPackageRevision>false</AppxAutoIncrementPackageRevision>
    <AppxBundle>Never</AppxBundle>
    <AppxBundlePlatforms>x86|x64|arm64</AppxBundlePlatforms>
    <AppxSymbolPackageEnabled>true</AppxSymbolPackageEnabled>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <AssemblyName>NotepadsEditorTests</AssemblyName>
    <RootNamespace>NotepadsEditorTests</RootNamespace>
    <EnableTypeInfoReflection>false</EnableTypeInfoReflection>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' != '' and '$(Platform)' != 'AnyCPU'">
    <RuntimeIdentifier>win-$([System.String]::Copy('$(Platform)').ToLowerInvariant())</RuntimeIdentifier>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Production'">
    <Optimize>true</Optimize>
    <DefineConstants>$(DefineConstants);TRACE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" />
    <PackageReference Include="Microsoft.UI.Xaml" />
    <PackageReference Include="UTF.Unknown" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Notepads.Native\Projection\Notepads.Native.Projection.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Notepads\Composition\SessionRegistry.cs" />
    <Compile Include="..\..\src\Notepads\Infrastructure\Storage\FutureAccessListUtility.cs" />
    <Compile Include="..\..\src\Notepads\Infrastructure\Runtime\InstanceCatalog.cs" />
    <Compile Include="..\..\src\Notepads\Features\Documents\**\*.cs" />
    <Compile Include="..\..\src\Notepads\Features\Sessions\**\*.cs" />
    <Compile Include="..\..\src\Notepads\Features\Preferences\FontSlant.cs" />
    <Compile Include="..\..\src\Notepads\Presentation\Theming\PreferenceValues.cs" />
    <Compile Include="..\..\src\Notepads\Infrastructure\Storage\FileStorage.cs" />
    <Compile Include="..\..\src\Notepads\Infrastructure\Storage\FileLockLease.cs" />
    <Compile Include="..\..\src\Notepads\Presentation\Controls\TextEditor\ScintillaTextEditorCore*.cs">
      <Link>Editor\%(Filename)%(Extension)</Link>
    </Compile>
    <Compile Include="..\..\src\Notepads\Presentation\Controls\TextEditor\TextEditorCore*.cs" />
    <Compile Include="..\..\src\Notepads\Presentation\Controls\TextEditor\SyntaxLanguageProfile.cs" />
    <Compile Include="..\..\src\Notepads\Presentation\Theming\SyntaxColorPalette.cs" />
    <Compile Include="..\..\src\Notepads\Presentation\Theming\DiffColorPalette.cs" />
    <Compile Include="..\..\src\Notepads\Presentation\Theming\EditorColorPalette.cs" />
    <Compile Include="..\..\src\Notepads\Presentation\Controls\TextEditor\DiffComparison.cs" />
    <Compile Include="..\..\src\Notepads\Presentation\Controls\FindAndReplace\SearchContext.cs" />
    <Compile Include="..\..\src\Notepads\Presentation\Input\KeyboardCommand*.cs" />
    <Compile Include="..\..\src\Notepads\Infrastructure\Storage\AtomicFileWriter.cs" />
    <Compile Include="..\..\src\Notepads\Infrastructure\Diagnostics\OperationMetrics.cs" />
    <Compile Include="..\..\src\Notepads\Infrastructure\Threading\WinRtAsyncExtensions.cs" />
    <Compile Include="..\..\src\Notepads\Features\WebSearch\SearchUrls.cs" />
    <Compile Include="..\..\src\Notepads\Presentation\Helpers\DispatcherExtensions.cs" />
    <Compile Include="..\..\src\Notepads\Presentation\Controls\TextEditor\ITextEditor.cs" />
    <Compile Include="..\..\src\Notepads\Presentation\Controls\TextEditor\TextEditorMode.cs" />
    <Compile Include="..\..\src\Notepads\Presentation\Controls\TextEditor\FileModificationState.cs" />
    <Compile Include="..\..\src\Notepads\Presentation\Workspace\INotepadsCore.cs" />
    <Compile Include="..\..\src\Notepads\Presentation\Workspace\ISessionController.cs" />
    <Compile Include="..\..\src\Notepads\Presentation\Workspace\SessionController.cs" />
  </ItemGroup>
  <ItemGroup>
    <Page Include="..\..\src\Notepads\Presentation\Theming\SyntaxThemes.xaml">
      <Link>Theming\SyntaxThemes.xaml</Link>
    </Page>
    <Page Include="..\..\src\Notepads\Presentation\Theming\DiffThemes.xaml">
      <Link>Theming\DiffThemes.xaml</Link>
    </Page>
    <Page Include="..\..\src\Notepads\Presentation\Theming\EditorThemes.xaml">
      <Link>Theming\EditorThemes.xaml</Link>
    </Page>
    <Content Include="..\..\src\Notepads\Assets\StoreLogo.scale-200.png">
      <Link>TestAssets\StoreLogo.scale-200.png</Link>
    </Content>
    <Content Include="..\..\src\Notepads\Assets\Square150x150Logo.scale-200.png">
      <Link>TestAssets\Square150x150Logo.scale-200.png</Link>
    </Content>
    <Content Include="..\..\src\Notepads\Assets\Square44x44Logo.scale-200.png">
      <Link>TestAssets\Square44x44Logo.scale-200.png</Link>
    </Content>
  </ItemGroup>
</Project>
