<Project>
  <!-- Publish evaluates packaging in an inner build. Copy its resolved framework
       packages there, rather than guessing NuGet/SDK paths in the outer driver. -->
  <Target Name="CollectOfflineFrameworkPackages"
          AfterTargets="_GetRecursiveResolvedSDKReferences"
          Condition="'$(OfflineFrameworkOutput)' != '' and '@(FrameworkSdkPackage)' != ''">
    <Copy SourceFiles="@(FrameworkSdkPackage)"
          DestinationFiles="@(FrameworkSdkPackage->'$(OfflineFrameworkOutput)%(Architecture)\%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
