<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Built-in syntax themes. Stable role keys form the palette boundary. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="SyntaxDefaultColor">#D4D4D4</Color>
            <Color x:Key="SyntaxCommentColor">#91B878</Color>
            <Color x:Key="SyntaxKeywordColor">#C5A5E8</Color>
            <Color x:Key="SyntaxStringColor">#E6AA88</Color>
            <Color x:Key="SyntaxNumberColor">#B5CEA8</Color>
            <Color x:Key="SyntaxOperatorColor">#D4D4D4</Color>
            <Color x:Key="SyntaxTypeColor">#6BD5C0</Color>
            <Color x:Key="SyntaxMarkupColor">#80BDF0</Color>
            <Color x:Key="SyntaxAttributeColor">#B8DBF2</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="SyntaxDefaultColor">#333333</Color>
            <Color x:Key="SyntaxCommentColor">#376B2C</Color>
            <Color x:Key="SyntaxKeywordColor">#6F268F</Color>
            <Color x:Key="SyntaxStringColor">#9D3B17</Color>
            <Color x:Key="SyntaxNumberColor">#216B45</Color>
            <Color x:Key="SyntaxOperatorColor">#333333</Color>
            <Color x:Key="SyntaxTypeColor">#006F6A</Color>
            <Color x:Key="SyntaxMarkupColor">#005BA1</Color>
            <Color x:Key="SyntaxAttributeColor">#07598A</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
