<UserControl
    x:Class="Notepads.Presentation.Controls.GoTo.GoToControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="250" Height="38">

    <Grid Padding="6,2,6,2" Height="38" x:Name="GoToRootGrid" KeyDown="GoToRootGrid_KeyDown">
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" x:Uid="GoTo_GoToBarLabel" Margin="0,0,8,0" FontSize="14" VerticalAlignment="Center" TextAlignment="Center"/>

        <Grid Grid.Column="1">
            <TextBox x:Name="GoToBar"
                     x:Uid="GoTo_GoToBar"
                     Style="{StaticResource TransparentTextBoxStyle}"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Center"
                     Height="32"
                     Padding="8,6,6,0"
                     Background="Transparent"
                     IsSpellCheckEnabled="False"
                     TextAlignment="Left"
                     BorderThickness="0"
                     FontSize="14"
                     BeforeTextChanging="GoToBar_BeforeTextChanging"
                     KeyDown="GoToBar_OnKeyDown"
                     GotFocus="GoToBar_GotFocus"
                     LostFocus="GoToBar_LostFocus"/>
        </Grid>

        <Button x:Name="SearchButton"
                x:Uid="GoTo_SearchButton"
                Width="40"
                Height="32"
                Padding="0"
                VerticalAlignment="Center"
                Grid.Column="2" 
                Visibility="{x:Bind GetSearchButtonVisibility(GoToBar.Text), Mode=OneWay}"
                IsTabStop="False"
                FontSize="14"
                Style="{StaticResource DismissButtonStyle}"
                Content="&#xEBE7;" 
                FontFamily="Segoe MDL2 Assets"
                Click="SearchButton_OnClick">
        </Button>

        <Button x:Name="DismissButton"
                x:Uid="FindAndReplace_DismissButton"
                IsTabStop="False"
                Width="40"
                Height="32"
                Padding="0"
                VerticalAlignment="Center"
                Grid.Column="3" 
                FontSize="14"
                Style="{StaticResource DismissButtonStyle}"
                Content="&#xE894;" 
                FontFamily="Segoe MDL2 Assets" 
                Click="DismissButton_OnClick" >
        </Button>
    </Grid>
</UserControl>
