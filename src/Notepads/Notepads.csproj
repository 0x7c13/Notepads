<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseUwp>true</UseUwp>
    <EnableMsixTooling>true</EnableMsixTooling>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <DefaultLanguage>en-US</DefaultLanguage>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Copyright>Copyright © 2019-2026 Jiaqi (0x7c13) Liu</Copyright>
    <Description>A modern, lightweight text editor with a minimalist design.</Description>
    <CsWinRTGenerateProjection>false</CsWinRTGenerateProjection>
    <Configurations>Debug;Release;Production</Configurations>
    <OutputType>WinExe</OutputType>
    <PublishAot>true</PublishAot>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <PublishAppxPackage>true</PublishAppxPackage>
    <IncludePublishItemsOutputGroup Condition="'$(Configuration)' != 'Debug'">true</IncludePublishItemsOutputGroup>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <SelfContained>true</SelfContained>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxAutoIncrementPackageRevision>false</AppxAutoIncrementPackageRevision>
    <AppxBundle>Never</AppxBundle>
    <AppxBundlePlatforms>x86|x64|arm64</AppxBundlePlatforms>
    <AppxSymbolPackageEnabled>true</AppxSymbolPackageEnabled>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <AssemblyName>Notepads</AssemblyName>
    <Win32Resource>Resource\MiddleClickScrolling-CursorType.res</Win32Resource>
    <DevLabel>-dev</DevLabel>
    <RootNamespace>Notepads</RootNamespace>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' != '' and '$(Platform)' != 'AnyCPU'">
    <RuntimeIdentifier>win-$([System.String]::Copy('$(Platform)').ToLowerInvariant())</RuntimeIdentifier>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Production'">
    <Optimize>true</Optimize>
    <DefineConstants>$(DefineConstants);TRACE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1" />
    <PackageReference Include="Microsoft.UI.Xaml" Version="2.8.7" />
    <PackageReference Include="Microsoft.Services.Store.Engagement" Version="10.2307.3001" />
    <PackageReference Include="UTF.Unknown" Version="2.7.0" />
    <PackageReference Include="Win2D.uwp" Version="1.28.3" />
    <PackageReference Include="CommunityToolkit.Uwp.Extensions" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.Uwp.Converters" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.Uwp.Helpers" Version="8.2.251219" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Notepads.Native\Projection\Notepads.Native.Projection.csproj" />
    <ProjectReference Include="..\Notepads.Controls\Notepads.Controls.csproj" />
    <SDKReference Include="Microsoft.Services.Store.Engagement, Version=10.0">
      <Name>Microsoft Engagement Framework</Name>
    </SDKReference>
  </ItemGroup>
  <ItemGroup>
    <!-- The legacy Markdown renderer remains disabled pending its replacement. -->
    <Compile Remove="Presentation\Controls\Markdown\**\*.cs" />
    <Page Remove="Presentation\Controls\Markdown\**\*.xaml" />
    <Page Update="Presentation\Theming\DiffThemes.xaml"><Link>Theming\DiffThemes.xaml</Link></Page>
    <Page Update="Presentation\Theming\SyntaxThemes.xaml">
      <Link>Theming\SyntaxThemes.xaml</Link>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <!-- Select the normal or development assets explicitly before mapping their package names. -->
    <Content Remove="Assets\**\*" />
    <Content Include="Resource\MiddleClickScrolling-CursorType.res" />
    <Content Include="Resource\Text Document.txt" />
    <Content Include="Assets\**\*$(DevLabel).png" Condition="'$(Configuration)' != 'Production'">
      <Link>$([System.String]::new('%(Identity)').Replace('$(DevLabel)',''))</Link>
    </Content>
    <Content Include="Assets\LockScreenLogo.scale-200.png" Condition="'$(Configuration)' != 'Production'" />
    <Content Include="Assets\*noise*.png" Condition="'$(Configuration)' != 'Production'" />
    <Content Include="Assets\search_*.png" Condition="'$(Configuration)' != 'Production'" />
    <Content Include="Assets\FileIcons\*.png" Condition="'$(Configuration)' != 'Production'" />
    <Content Include="Assets\**\*.png" Exclude="Assets\**\*$(DevLabel).png" Condition="'$(Configuration)' == 'Production'" />
    <Content Include="..\Notepads.Native\LICENSE">
      <Link>ThirdPartyNotices\WinUIEdit.txt</Link>
    </Content>
    <Content Include="..\Notepads.Native\scintilla\License.txt">
      <Link>ThirdPartyNotices\Scintilla.txt</Link>
    </Content>
    <Content Include="..\Notepads.Native\lexilla\License.txt">
      <Link>ThirdPartyNotices\Lexilla.txt</Link>
    </Content>
  </ItemGroup>
  <Import Project="Package.targets" />
</Project>
