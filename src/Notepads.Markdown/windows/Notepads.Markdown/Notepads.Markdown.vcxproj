    <!-- XAML's generated activation table references the implementation class.
         Keep this dependency local to generated XAML units rather than the PCH. -->
    <Target Name="PrepareNotepadsMarkdownXamlCompile" BeforeTargets="ClCompile">
        <ItemGroup>
            <ClCompile>
                <ForcedIncludeFiles Condition="'%(ClCompile.Filename)' == 'XamlTypeInfo.g' or '%(ClCompile.Filename)' == 'XamlTypeInfo.Impl.g'">pch.h;Control\MarkdownView.h;%(ClCompile.ForcedIncludeFiles)</ForcedIncludeFiles>
            </ClCompile>
        </ItemGroup>
    </Target>
    <!-- Output-group queries do not execute CreateWinMD/Link. Cargo fingerprints every real
         native link invocation, including an otherwise up-to-date build. -->
    <Target Name="BuildNotepadsMarkdownRust" BeforeTargets="CreateWinMD;Link" Condition="'$(DesignTimeBuild)' != 'true'">
        <Exec Command="&quot;$(SystemRoot)\System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoLogo -NoProfile -ExecutionPolicy Bypass -File &quot;$(NotepadsMarkdownRoot)scripts\Build-Rust.ps1&quot; -Target &quot;$(NotepadsMarkdownRustTarget)&quot; -TargetDirectory &quot;$(NotepadsMarkdownRustTargetDir).&quot; -StagedLibrary &quot;$(NotepadsMarkdownRustLibrary)&quot; -NativeOutput &quot;$(OutDir)$(TargetName).dll&quot; -TrackedHeader &quot;$(GeneratedFilesDir)winrt\Notepads.Markdown.h&quot; -VsInstallRoot &quot;$(VsInstallRoot)\.&quot; -Diagnostics &quot;$(NotepadsMarkdownEnableDiagnostics)&quot;" />
        <Error Condition="!Exists('$(NotepadsMarkdownRustLibrary)')" Text="Cargo did not produce the matching Rust static library." />
