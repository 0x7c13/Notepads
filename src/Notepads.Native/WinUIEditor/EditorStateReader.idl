namespace WinUIEditor
{
	[default_interface]
	runtimeclass EditorStateReader : Windows.Foundation.IClosable
	{
		UInt64 Length { get; };
		UInt64 Sequence { get; };
		// Sequential bounded chunks; callers must await each read before the next.
		Windows.Foundation.IAsyncOperation<Windows.Storage.Streams.IBuffer> ReadAsync();
	}
}
