#include "Defines.idl"
import "EditorWrapper.idl";
import "IEditorAccess.idl";

namespace WinUIEditor
{
	[default_interface]
	[webhosthidden]
	runtimeclass EditorBaseControl : DUX.Controls.Control, IEditorAccess
	{
		EditorBaseControl();
		Editor Editor { get; };
		Boolean IsComposing { get; };
		Boolean HasTextStoreLock { get; };
		// Hosts that own zoom policy can handle the unconsumed routed wheel event.
		Boolean MouseWheelZoomEnabled;
		// Unlike SCI_STYLESETBACK, this preserves alpha for XAML backdrops.
		void SetBackgroundColor(Windows.UI.Color color);
		// Apply a saved document anchor before drawing, after DPI and layout are ready.
		// horizontalOffset is a DIP distance from the reading-order leading edge.
		// documentLine -1 follows the current caret once layout is ready.
		// Temporary view changes may preserve the existing vertical-navigation column.
		void RestoreViewport(Double horizontalOffset, Int64 documentLine, Int64 subLine, Double verticalOffset, Boolean preservePreferredColumn);
		// Unwrapped display rows and a DIP offset from the reading-order leading edge.
		// Applied before paint; retained across canvas growth, resize and DPI changes.
		void SetDisplayViewport(Int64 row, Double leadingOffset, Double verticalOffset);
		// An immediate display-row anchor and a local DIP offset, clamped to the viewport.
		void SetVerticalViewport(Int64 row, Double offset);
		Double DisplayVerticalOffset { get; };
		// Relative screen-axis DIPs: positive is right/down, also in RTL.
		// Animated requests respect Windows animation settings; wrap suppresses X.
		void ScrollBy(Double horizontalDelta, Double verticalDelta, Boolean animated);
		Boolean IsScrollAnimating { get; };
		void CancelScrollAnimation();
		// Raised once per user scroll interaction, before the viewport moves.
		// Horizontal-only input raises it too: observers that share a viewport
		// should retire their own motion regardless of the axis.
		event Windows.Foundation.EventHandler<Object> ScrollStarted;
		// Current or pending DIP offset from the reading-order leading edge.
		Double DisplayHorizontalOffset { get; };
		Int64 DisplayFirstVisibleRow { get; };
		Boolean IsViewportRestorePending { get; };
		// Native gutter in control-relative DIPs, excluding text padding and scrollbars.
		Windows.Foundation.Rect GutterBounds { get; };
		// Coalesced after arrangement, including position-only scrollbar-side changes.
		event Windows.Foundation.EventHandler<Object> ViewportGeometryChanged;
		event Windows.Foundation.EventHandler<Double> DpiChanged;
	}
}
